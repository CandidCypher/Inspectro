<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_inspection_description</name>
  <version>0.1.0</version>
  <description>UR30 robot description with a Zivid 2+ MR60 3D camera mounted on the tool flange.</description>
  <maintainer email="cameronallanowens@gmail.com">Cameron Owens</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>zivid_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
